# VITE_BFF_URL is optional. Unset: `npm run dev` calls http://localhost:3000,
# and a production build calls /bff/... relative (same origin as the page).
# Set it only to point at a different BFF; a trailing slash is stripped.
# Don't leave a localhost value in .env when running `npm run build`: Vite
# loads .env in every mode, and CI fails any dist/ containing localhost:3000.
# VITE_BFF_URL=http://localhost:3000
VITE_PERSON_ID=1
